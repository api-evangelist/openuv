                    "value": "<API Key>"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/protection?lat=<float>&lng=<float>&alt=<float>&from=3.5&to=3.5",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "protection"
                  ],
                  "query": [
                    {
                      "description": "(Required) Latitude in decimal degrees (-90 to 90).",
                      "key": "lat",
                      "value": "<float>"
                    },
