{
  "info": {
    "_postman_id": "ecf9745b-8a34-45d2-941d-4e4c4db8613a",
    "name": "OpenUV Account UV Index API",
    "description": "Global real-time UV index API. Returns current UV index, daily maximum UV, ozone level,\nsafe sun-exposure times per Fitzpatrick skin type, sun position, and a recommended sun\nprotection window for any geographic coordinate. All endpoints are GET-only and require\nan OpenUV API key supplied in the `x-access-token` header.\n\n\nContact Support:\n Name: OpenUV Support\n Email: support@openuv.io",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:26:50.000Z",
    "updatedAt": "2026-07-28T02:26:50.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-ecf9745b-8a34-45d2-941d-4e4c4db8613a"
  },
  "item": [
    {
      "name": "uv",
      "item": [
        {
          "name": "Get Current UV Index",
          "id": "d9ce8efd-7021-42da-a409-b63e19fbc1d0",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/uv?lat=<float>&lng=<float>&alt=<float>&dt=<dateTime>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "uv"
              ],
              "query": [
                {
                  "description": "(Required) Latitude in decimal degrees (-90 to 90).",
                  "key": "lat",
                  "value": "<float>"
                },
                {
                  "description": "(Required) Longitude in decimal degrees (-180 to 180).",
                  "key": "lng",
                  "value": "<float>"
                },
                {
                  "description": "Altitude in meters above sea level. Improves UV accuracy for high-elevation locations.",
                  "key": "alt",
                  "value": "<float>"
                },
                {
                  "description": "ISO 8601 timestamp for the requested UV reading or forecast anchor. Defaults to the current time.",
                  "key": "dt",
                  "value": "<dateTime>"
                }
              ]
            },
            "description": "Returns the current UV index, daily maximum UV, ozone level, sun position\nand Fitzpatrick skin-type-specific safe exposure times for the given coordinate.\n"
          },
          "response": [
            {
              "id": "c821baa5-cea5-493f-aba8-53ad0f76a961",
              "name": "Current UV index reading",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "description": "Added as a part of security scheme: apikey",
                    "key": "x-access-token",
                    "value": "<API Key>"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/uv?lat=<float>&lng=<float>&alt=<float>&dt=<dateTime>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "uv"
                  ],
                  "query": [
                    {
                      "description": "(Required) Latitude in decimal degrees (-90 to 90).",
                      "key": "lat",
                      "value": "<float>"
                    },
                    {
                      "description": "(Required) Longitude in decimal degrees (-180 to 180).",
                      "key": "lng",
                      "value": "<float>"
                    },
                    {
                      "description": "Altitude in meters above sea level. Improves UV accuracy for high-elevation locations.",
                      "key": "alt",
                      "value": "<float>"
                    },
                    {
                      "description": "ISO 8601 timestamp for the requested UV reading or forecast anchor. Defaults to the current time.",
                      "key": "dt",
                      "value": "<dateTime>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "responseTime": null,
              "body": "{\n  \"result\": {\n    \"uv\": \"<float>\",\n    \"uv_time\": \"<dateTime>\",\n    \"uv_max\": \"<float>\",\n    \"uv_max_time\": \"<dateTime>\",\n    \"ozone\": \"<float>\",\n    \"ozone_time\": \"<dateTime>\",\n    \"safe_exposure_time\": {\n      \"st1\": \"<integer>\",\n      \"st2\": \"<integer>\",\n      \"st3\": \"<integer>\",\n      \"st4\": \"<integer>\",\n      \"st5\": \"<integer>\",\n      \"st6\": \"<integer>\"\n    },\n    \"sun_info\": {\n      \"sun_times\": {\n        \"solarNoon\": \"<dateTime>\",\n        \"nadir\": \"<dateTime>\",\n        \"sunrise\": \"<dateTime>\",\n        \"sunset\": \"<dateTime>\",\n        \"sunriseEnd\": \"<dateTime>\",\n        \"sunsetStart\": \"<dateTime>\",\n        \"dawn\": \"<dateTime>\",\n        \"dusk\": \"<dateTime>\",\n        \"nauticalDawn\": \"<dateTime>\",\n        \"nauticalDusk\": \"<dateTime>\",\n        \"nightEnd\": \"<dateTime>\",\n        \"night\": \"<dateTime>\",\n        \"goldenHourEnd\": \"<dateTime>\",\n        \"goldenHour\": \"<dateTime>\"\n      },\n      \"sun_position\": {\n        \"azimuth\": \"<float>\",\n        \"altitude\": \"<float>\"\n      }\n    }\n  }\n}",
