        {
          "id": "9661b98a-fb58-4523-a36b-15e72e38328a",
          "name": "Get Current UV Index",
          "request": {
            "name": "Get Current UV Index",
            "description": {
              "content": "Returns the current UV index, daily maximum UV, ozone level, sun position\nand Fitzpatrick skin-type-specific safe exposure times for the given coordinate.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "uv"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<float>",
                  "description": "(Required) Latitude in decimal degrees (-90 to 90)."
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<float>",
                  "description": "(Required) Longitude in decimal degrees (-180 to 180)."
                },
                {
                  "disabled": false,
                  "key": "alt",
                  "value": "<float>",
                  "description": "Altitude in meters above sea level. Improves UV accuracy for high-elevation locations."
                },
                {
                  "disabled": false,
                  "key": "dt",
                  "value": "<dateTime>",
                  "description": "ISO 8601 timestamp for the requested UV reading or forecast anchor. Defaults to the current time."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
